---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import {getPublishedPosts} from '../../lib/posts';
export async function getStaticPaths(){return (await getPublishedPosts()).map(post=>({params:{id:post.data.postId},props:{post}}));}
const {post} = Astro.props;
---
<Base title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date.toISOString()}><Article post={post}/></Base>
