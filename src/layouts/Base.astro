---
import { site } from '../config';
const { title, description = site.description, noindex = false, type = 'website', publishedTime } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="description" content={description}/>
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}favicon.svg`}/>
    {!noindex && <link rel="canonical" href={canonical}/>}
    {noindex && <meta name="robots" content="noindex, nofollow"/>}
    <meta property="og:site_name" content={site.title}/>
    <meta property="og:locale" content="ko_KR"/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content={type}/>
    <meta property="og:url" content={canonical}/>
    {publishedTime && <meta property="article:published_time" content={publishedTime}/>}
    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content={pageTitle}/>
    <meta name="twitter:description" content={description}/>
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={`${base}rss.xml`}/>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 이동</a>
    <header>
      <a class="brand" href={base}>개발의 기록<span>BACKEND · FULLSTACK</span></a>
      <nav aria-label="주 메뉴">
        <a href={base} aria-current={Astro.url.pathname === base ? 'page' : undefined}>기록</a>
        <a href={`${base}projects/`} aria-current={Astro.url.pathname === `${base}projects/` ? 'page' : undefined}>프로젝트</a>
        <a href={`${base}about/`} aria-current={Astro.url.pathname === `${base}about/` ? 'page' : undefined}>소개</a>
      </nav>
    </header>
    <main id="main"><slot/></main>
    <footer>
      <p>AI와 함께 개발한 경험을 AI로 정리하고, 제가 검토해 발행합니다.</p>
      <div class="footer-links"><a href={`${base}about/`}>작성 원칙</a><a href={site.repository}>GitHub 저장소</a><a href={`${base}rss.xml`}>RSS 구독</a></div>
    </footer>
  </body>
</html>
<style is:global>
  :root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#252b34;background:#f8f7f3;line-height:1.8;color-scheme:light dark;--muted:#646c77;--line:#deded7;--accent:#196d60;--panel:#eeeee7}
  *{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:5px}a:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:5px;border-radius:3px}
  header,main,footer{max-width:1040px;margin:auto;padding:32px}header{display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line)}
  .brand{text-decoration:none;font-weight:800;font-size:23px;letter-spacing:-1px}.brand span{display:block;font-size:10px;letter-spacing:1.7px;color:var(--accent)}nav{display:flex;gap:24px;font-size:14px}nav a{text-decoration:none;padding:6px 0}nav a[aria-current=page]{color:var(--accent);font-weight:700}
  footer{color:var(--muted);font-size:13px;border-top:1px solid var(--line)}.footer-links{display:flex;gap:20px;flex-wrap:wrap}main{min-height:65vh;padding-top:64px}
  h1{font-size:clamp(32px,5vw,54px);line-height:1.3;letter-spacing:-1.5px}h2{line-height:1.5}p,li{word-break:keep-all;overflow-wrap:anywhere}.eyebrow{font-size:12px;letter-spacing:2px;color:var(--accent);font-weight:700}.intro{max-width:690px;color:var(--muted);font-size:17px}.text-link{color:var(--accent)}
  .process{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;margin:28px 0}.process li{border:1px solid var(--line);border-radius:100px;padding:5px 14px;font-size:13px}.cards{margin-top:52px}.section-heading{font-size:19px;letter-spacing:-.4px}.card{display:block;padding:28px 0;border-top:1px solid var(--line);text-decoration:none}.card:hover h3{color:var(--accent)}.card h3{margin:8px 0;font-size:25px;line-height:1.5}.meta,.tags{font-size:13px;color:var(--muted)}.tag{margin-right:12px}.empty{padding:28px 0;color:var(--muted);border-top:1px solid var(--line)}
  article,.prose{max-width:740px;margin:auto}.prose h2{margin-top:38px}article img{max-width:100%;height:auto}article pre{padding:20px;border-radius:8px;overflow:auto}article table{display:block;overflow:auto;border-collapse:collapse}article th,article td{padding:10px;border:1px solid var(--line)}article blockquote{border-left:3px solid var(--accent);padding-left:20px}article h2,article h3{margin-top:36px}.back-link{font-size:14px;color:var(--muted)}.writing-note,.preview-note{padding:16px 20px;background:var(--panel);border-radius:8px;font-size:14px;margin:32px 0}.writing-note a{color:var(--accent)}.comments{margin-top:70px;padding-top:30px;border-top:1px solid var(--line)}
  .hero-links{display:flex;gap:22px;align-items:center;flex-wrap:wrap;margin:28px 0}.primary-link{background:var(--accent);color:#fff;padding:10px 18px;border-radius:6px;font-size:14px;font-weight:700;text-decoration:none}.evidence{background:var(--panel);padding:24px;border-radius:8px;margin:32px 0}.evidence h2{margin-top:0}.evidence dl{margin-bottom:0}.evidence dt{font-size:13px;font-weight:700;color:var(--accent);margin-top:20px}.evidence dd{margin:4px 0 0;overflow-wrap:anywhere}.evidence-links{display:flex;gap:20px;flex-wrap:wrap;list-style:none;padding:0;font-size:14px}
  .skip{position:absolute;top:-100px}.skip:focus{top:5px;background:var(--panel);padding:8px;z-index:10}@media(max-width:600px){header,main,footer{padding:24px}header{align-items:flex-start;flex-direction:column;gap:16px}nav{gap:24px}main{padding-top:40px}.intro{font-size:16px}}@media(prefers-color-scheme:dark){:root{color:#e7e9eb;background:#161b21;--muted:#a7afb8;--line:#353e46;--accent:#80cdbb;--panel:#202830}.primary-link{color:#10241e}}
</style>
