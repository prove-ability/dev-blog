---
import Base from '../layouts/Base.astro';
import {getPublishedPosts} from '../lib/posts';
import {seriesCatalog, getSeriesPosts, type SeriesId} from '../lib/series';
const posts = await getPublishedPosts();
const series = (Object.keys(seriesCatalog) as SeriesId[])
  .map(id => ({id, ...seriesCatalog[id], count: getSeriesPosts(posts, id).length}))
  .filter(item => item.count > 0);
const base = import.meta.env.BASE_URL;
---
<Base>
  <h1 class="blog-heading">개발하며 배운 것들</h1>
  <p class="intro">만들면서 마주친 문제와 해결 과정, 새로 배운 내용을 기록합니다.</p>
  {series.length > 0 && <section class="series-list">
    <h2 class="section-heading">시리즈</h2>
    {series.map(item => <article class="series-card">
      <h3><a href={`${base}series/${item.id}/`}>{item.title}</a></h3>
      <p>{item.description}</p>
      <span class="meta">발행된 글 {item.count}편</span>
    </article>)}
  </section>}
  <section class="cards" aria-labelledby="posts-heading">
    <h2 class="section-heading" id="posts-heading">개발 기록 <span class="meta">{posts.length}편</span></h2>
    {posts.length ? posts.map(post=><a class="card" href={`${base}posts/${post.data.postId}/`}><time class="meta" datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10)}</time>{post.data.series && <p class="post-series">{seriesCatalog[post.data.series.id].title} · {post.data.series.order}편</p>}<h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><span class="tag">#{tag}</span>)}</div></a>) : <div class="empty"><p>첫 번째 글을 준비하고 있습니다.</p></div>}
  </section>
</Base>
<style>
  .series-list { margin-top: 40px; }
  .series-card { max-width: none; padding: 20px 24px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; }
  .series-card + .series-card { margin-top: 16px; }
  .series-card h3 { margin: 0; font-size: 18px; }
  .series-card p { margin: 8px 0; color: var(--muted); font-size: 14px; }
  .post-series { margin: 8px 0; color: var(--accent); font-size: 13px; }
</style>
