---
const {title = '개발의 기록', description = '직접 만들고 검증하며 쌓아가는 개발 경험'} = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · 개발의 기록</title><link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`}/>{Astro.site && Astro.site.hostname !== 'example.invalid' && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>}</head><body><a class="skip" href="#main">본문으로 이동</a><header><a class="brand" href={import.meta.env.BASE_URL}>개발의 기록<span>BUILD · LEARN · WRITE</span></a><span class="note">작은 실험, 오래 남는 배움.</span></header><main id="main"><slot/></main><footer>직접 경험한 문제와 선택, 그리고 배운 것들을 기록합니다.</footer></body></html>
<style is:global>
:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#252b34;background:#f8f7f3;line-height:1.8;color-scheme:light dark;--muted:#646c77;--line:#deded7;--accent:#196d60}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:5px}header,main,footer{max-width:1040px;margin:auto;padding:32px}header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{text-decoration:none;font-weight:800;font-size:23px;letter-spacing:-1px}.brand span{display:block;font-size:10px;letter-spacing:2px;color:var(--accent)}.note,footer{color:var(--muted);font-size:13px}main{min-height:65vh;padding-top:64px}h1{font-size:clamp(32px,5vw,54px);line-height:1.3;letter-spacing:-1.5px}h2{line-height:1.5}p{word-break:keep-all;overflow-wrap:anywhere}.eyebrow{font-size:12px;letter-spacing:2px;color:var(--accent);font-weight:700}.intro{max-width:650px;color:var(--muted)}.cards{margin-top:52px}.card{display:block;padding:28px 0;border-top:1px solid var(--line);text-decoration:none}.card h2{margin:8px 0;font-size:25px}.meta,.tags{font-size:13px;color:var(--muted)}.tag{margin-right:12px}.empty{padding:40px 0;color:var(--muted)}article{max-width:740px;margin:auto}article img{max-width:100%;height:auto}article pre{padding:20px;border-radius:8px;overflow:auto}article blockquote{border-left:3px solid var(--accent);padding-left:20px}.comments{margin-top:70px;padding-top:30px;border-top:1px solid var(--line)}footer{border-top:1px solid var(--line)}.skip{position:absolute;top:-100px}.skip:focus{top:5px}@media(max-width:600px){header,main,footer{padding:24px}.note{display:none}main{padding-top:40px}}@media(prefers-color-scheme:dark){:root{color:#e7e9eb;background:#161b21;--muted:#a7afb8;--line:#353e46;--accent:#80cdbb}}
</style>
