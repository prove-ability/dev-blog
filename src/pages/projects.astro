---
import Base from '../layouts/Base.astro';
import {getPublishedPosts} from '../lib/posts';
const projects=(await getPublishedPosts()).filter(post=>post.data.kind==='project').sort((a,b)=>Number(b.data.featured)-Number(a.data.featured));
const base=import.meta.env.BASE_URL;
---
<Base title="프로젝트 기록" description="직접 만들어 보며 배운 것들과 해결 과정을 모은 글입니다.">
  <h1 class="blog-heading">프로젝트 기록</h1>
  <p class="intro">무언가를 만들어 보며 배운 것들을 모았습니다.</p>
  <div class="cards">{projects.length ? projects.map(post=><a class="card" href={`${base}posts/${post.data.postId}/`}><h2>{post.data.title}</h2><p>{post.data.description}</p><p class="meta">{post.data.tags.join(' · ')}</p></a>):<div class="empty"><p>아직 이 분류의 글이 없습니다.</p></div>}</div>
</Base>
